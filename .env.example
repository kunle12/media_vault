# Flask Configuration
SECRET_KEY=replace-with-a-long-random-value

# Server Configuration
APPLICATION_ROOT=/mediavault
# SERVER_NAME=www.example.org

# File Storage
UPLOAD_FOLDER=/media/nas/Media/vault
DATABASE=/media/nas/Media/vault/videodb.sqlite
MAX_CONTENT_LENGTH_MB=500

# Production safety: refuse to open storage unless this is a real mount.
# The access also triggers the systemd automount.
# REQUIRE_MOUNT_POINT=/media/nas

# Dashboard Pagination
# ITEMS_PER_PAGE=50

# This app has no local login. nginx performs the guard auth_request and
# forwards X-Auth-User / X-Auth-Groups. Never expose gunicorn directly.

# AWS S3 Storage (optional)
# S3_BUCKET=your-bucket-name
# S3_PREFIX=media/
# S3_ENDPOINT=https://s3.amazonaws.com
# AWS_REGION=us-east-1

# Azure Storage (optional)
# AZURE_STORAGE_ACCOUNT=your-account-name
# AZURE_STORAGE_KEY=your-storage-key
# AZURE_CONTAINER=media
# AZURE_CONNECTION_STRING=your-connection-string
