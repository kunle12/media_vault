SECRET_KEY=replace-with-a-long-random-value
APPLICATION_ROOT=/mediavault
SERVER_NAME=www.kunle12.org

DATABASE=/media/nas/Media/vault/videodb.sqlite
UPLOAD_FOLDER=/media/nas/Media/vault
MAX_CONTENT_LENGTH_MB=500

# Refuse to create data on the root disk if the USB disk is absent.
# Accessing the path also triggers the systemd automount.
REQUIRE_MOUNT_POINT=/media/nas

# Dashboard pagination (items per page)
# ITEMS_PER_PAGE=50

# Identity is supplied by the guard through nginx. There is no local login,
# SMTP, OAuth, or allowed-email list in this build.

# S3 Storage (optional)
# S3_BUCKET=your-bucket-name
# S3_PREFIX=media/
# AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1

# Azure Storage (optional)
# AZURE_STORAGE_ACCOUNT=your-account-name
# AZURE_STORAGE_KEY=your-account-key
# AZURE_CONTAINER=media
